#: admin.py:82
msgid "ID"
msgstr "ID"

#: admin.py:91
msgid "Task"
msgstr "Tarea"

#: admin.py:109
msgid "Status"
msgstr "Estado"

#: admin.py:117
msgid "Run selected tasks"
msgstr "Ejecutar tareas seleccionadas"

#: admin.py:163
msgid "Retry failed tasks"
msgstr "Reintentar tareas fallidas"

#: admin.py:217
msgid "Requeue tasks stuck in running"
msgstr "Reencolar tareas atascadas en ejecución"

#: management/commands/purge_completed_database_tasks.py:17
msgid "Delete completed task records from the database"
msgstr "Elimina de la base de datos los registros de tareas completadas"

#: management/commands/purge_completed_database_tasks.py:24
msgid "Delete tasks completed more than N days ago (0=all, default: 0)"
msgstr ""
"Elimina las tareas completadas hace más de N días (0=todas, predeterminado: "
"0)"

#: management/commands/purge_completed_database_tasks.py:30
msgid "Target statuses, comma-separated (default: SUCCESSFUL,FAILED)"
msgstr ""
"Estados objetivo, separados por comas (predeterminado: SUCCESSFUL,FAILED)"

#: management/commands/purge_completed_database_tasks.py:35
msgid "Only delete tasks with this task path (default: all tasks)"
msgstr ""
"Elimina solo las tareas con esta ruta de tarea (predeterminado: todas las "
"tareas)"

#: management/commands/purge_completed_database_tasks.py:41
msgid "Number of tasks to delete at once (default: 1000)"
msgstr "Número de tareas a eliminar de una vez (predeterminado: 1000)"

#: management/commands/purge_completed_database_tasks.py:46
msgid "Show count only without deleting"
msgstr "Solo muestra el recuento, sin eliminar"

#: management/commands/requeue_stale_database_tasks.py:54
msgid ""
"Recover tasks left in RUNNING status by a worker that was killed before it "
"could write a result"
msgstr ""
"Recupera las tareas que quedaron en estado RUNNING porque su worker terminó "
"abruptamente antes de escribir el resultado"

#: management/commands/requeue_stale_database_tasks.py:64
msgid ""
"Only touch tasks that have been RUNNING for longer than this, as a number "
"and a unit: 90s, 15m, 2h, 1d. Required, and it must be longer than your "
"longest running task - a task still running when its threshold passes is "
"requeued and ends up running twice"
msgstr ""
"Afecta solo a las tareas que llevan en RUNNING más tiempo que este, como un "
"número y una unidad: 90s, 15m, 2h, 1d. Obligatorio, y debe ser mayor que su "
"tarea más larga - una tarea que sigue en ejecución cuando pasa el umbral se "
"reencola y termina ejecutándose dos veces"

#: management/commands/requeue_stale_database_tasks.py:75
msgid "Queue name to recover (all queues if not specified)"
msgstr "Nombre de la cola a recuperar (todas las colas si no se indica)"

#: management/commands/requeue_stale_database_tasks.py:81
msgid "Backend name to recover (all backends if not specified)"
msgstr "Nombre del backend a recuperar (todos los backends si no se indica)"

#: management/commands/requeue_stale_database_tasks.py:88
#, python-format
msgid ""
"Mark a task FAILED instead of requeueing it once it has been handed to this "
"many workers (0=no limit, default: %(max_attempts)s). Stops a task that "
"kills its worker from being requeued forever"
msgstr ""
"Marca la tarea como FAILED en lugar de reencolarla una vez que se ha "
"entregado a este número de workers (0=sin límite, predeterminado: "
"%(max_attempts)s). Evita que una tarea que tumba a su worker se reencole "
"para siempre"

#: management/commands/requeue_stale_database_tasks.py:99
msgid ""
"Mark every stale task FAILED instead of requeueing it. For tasks that are "
"not safe to run twice"
msgstr ""
"Marca todas las tareas estancadas como FAILED en lugar de reencolarlas. Para "
"tareas que no es seguro ejecutar dos veces"

#: management/commands/requeue_stale_database_tasks.py:107
msgid ""
"Tell the backend's broker about each requeued task. Needed when workers only "
"receive from a broker, because the message for the killed attempt is already "
"gone"
msgstr ""
"Avisa al broker del backend de cada tarea reencolada. Necesario cuando los "
"workers solo reciben del broker, porque el mensaje del intento interrumpido "
"ya no existe"

#: management/commands/requeue_stale_database_tasks.py:116
msgid "Number of tasks to process at once (default: 1000)"
msgstr "Número de tareas a procesar de una vez (predeterminado: 1000)"

#: management/commands/requeue_stale_database_tasks.py:121
msgid "Show what would happen without changing anything"
msgstr "Muestra lo que ocurriría sin cambiar nada"

#: management/commands/run_database_tasks.py:55
msgid "Execute tasks queued in the database"
msgstr "Ejecuta las tareas encoladas en la base de datos"

#: management/commands/run_database_tasks.py:62
msgid "Queue name to process (all queues if not specified)"
msgstr "Nombre de la cola a procesar (todas las colas si no se indica)"

#: management/commands/run_database_tasks.py:68
msgid "Backend name (default: default)"
msgstr "Nombre del backend (predeterminado: default)"

#: management/commands/run_database_tasks.py:73
msgid "Continuous mode (keep polling even when no tasks)"
msgstr "Modo continuo (sigue sondeando aunque no haya tareas)"

#: management/commands/run_database_tasks.py:79
msgid "Polling interval in seconds for continuous mode (default: 5)"
msgstr "Intervalo de sondeo en segundos en modo continuo (predeterminado: 5)"

#: management/commands/run_database_tasks.py:85
msgid "Maximum number of tasks to process (0=unlimited, default: 0)"
msgstr "Número máximo de tareas a procesar (0=ilimitado, predeterminado: 0)"

#: management/commands/run_database_tasks.py:92
msgid ""
"Where to look for tasks: 'db' polls the database, 'broker' receives from the "
"backend's broker, 'both' does the broker first and falls back to the "
"database, and 'auto' (default) means 'both' when the backend has a broker to "
"receive from and 'db' otherwise"
msgstr ""
"Dónde buscar tareas: 'db' sondea la base de datos, 'broker' recibe del "
"broker del backend, 'both' usa primero el broker y recurre a la base de "
"datos, y 'auto' (predeterminado) significa 'both' cuando el backend tiene un "
"broker del que recibir y 'db' en caso contrario"

#: management/commands/run_database_tasks.py:104
msgid ""
"Seconds to wait for a broker message before looking again. Replaces --"
"interval as the idle wait when receiving from a broker (default: 20)"
msgstr ""
"Segundos de espera a un mensaje del broker antes de volver a comprobar. "
"Sustituye a --interval como espera inactiva al recibir de un broker "
"(predeterminado: 20)"

#: management/commands/run_database_tasks.py:114
msgid "Maximum number of broker messages to receive at a time (default: 1)"
msgstr ""
"Número máximo de mensajes del broker a recibir de una vez (predeterminado: 1)"

#: management/commands/run_database_tasks.py:123
msgid ""
"Run this many worker processes from one command, each a copy of this command "
"without --workers. With --continuous a worker that exits is replaced; "
"without it the command exits when every worker has (default: 1)"
msgstr ""
"Ejecuta esta cantidad de procesos worker desde un solo comando, cada uno una "
"copia de este comando sin --workers. Con --continuous, un worker que termina "
"se reemplaza; sin él, el comando termina cuando todos los workers lo hayan "
"hecho (predeterminado: 1)"

#: management/commands/run_database_tasks.py:134
msgid ""
"Maximum seconds to wait for the running task after receiving SIGTERM/SIGINT "
"before forcing exit (0=wait indefinitely, default: 0)"
msgstr ""
"Segundos máximos de espera a la tarea en ejecución tras recibir SIGTERM/"
"SIGINT antes de forzar la salida (0=esperar indefinidamente, predeterminado: "
"0)"

#: management/commands/run_database_tasks.py:143
msgid ""
"Do not install SIGTERM/SIGINT handlers; the process is terminated "
"immediately, even while a task is running"
msgstr ""
"No instala manejadores de SIGTERM/SIGINT; el proceso termina de inmediato, "
"incluso con una tarea en ejecución"

#: management/commands/run_database_tasks.py:153
msgid ""
"Exit with this code when no task was processed, so a job scheduler can tell "
"an idle run from a real one (0=exit normally, default: 0)"
msgstr ""
"Termina con este código cuando no se procesó ninguna tarea, para que un "
"planificador de trabajos distinga una ejecución vacía de una real "
"(0=terminar normalmente, predeterminado: 0)"

#: management/commands/run_database_tasks.py:164
msgid ""
"Exit with this code when at least one task failed or could not be run. Takes "
"precedence over --empty-exit-code (0=exit normally, default: 0)"
msgstr ""
"Termina con este código cuando al menos una tarea falló o no se pudo "
"ejecutar. Tiene prioridad sobre --empty-exit-code (0=terminar normalmente, "
"predeterminado: 0)"

